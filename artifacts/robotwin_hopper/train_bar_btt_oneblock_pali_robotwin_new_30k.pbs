#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N bar_btt_oneblock
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from the bimanual_tokenizer repository root}"
: "${TOKENIZER_CHECKPOINT:?Submit with qsub -v TOKENIZER_CHECKPOINT=/absolute/checkpoint/path}"
HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
test -f "$HOPPER_SINGULARITY_IMAGE"
module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
  env TOKENIZER_CHECKPOINT="$TOKENIZER_CHECKPOINT" \
  bash artifacts/robotwin_hopper/train_bar_btt_oneblock_pali_robotwin_new_30k.sh
