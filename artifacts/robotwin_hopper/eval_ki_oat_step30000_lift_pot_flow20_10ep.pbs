#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N kioat_f20_lift10
#PBS -P CFP05-CF-002
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export PRAXIS_CHECKPOINT=${PRAXIS_CHECKPOINT:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/hopper_ki_oat_pali_fft_1xh200_robotwin_2500/603100.hopper-m-02/train/checkpoints/best/step_30000/pretrained_model}
export ROBOTWIN_TASK=lift_pot
export EPISODES_PER_TASK=10
export RECORD_EPISODES_PER_TASK=10
export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-500}
export FLOW_SAMPLING_STEPS=20
export ROBOTWIN_RUN_ID=${ROBOTWIN_RUN_ID:-ki-oat-pali-step30000-lift-pot-flow20-10ep}
export ROBOTWIN_OUTPUT_DIR=${ROBOTWIN_OUTPUT_DIR:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/best-checkpoint-5tasks-20ep/ki_oat_pali_fft_step30000/flow20_10ep}
export POLICY_PORT=${POLICY_PORT:-50100}

test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"

echo "ROBOTWIN_FLOW20_EVAL checkpoint=$PRAXIS_CHECKPOINT task=$ROBOTWIN_TASK episodes=$EPISODES_PER_TASK flow_sampling_steps=$FLOW_SAMPLING_STEPS output=$ROBOTWIN_OUTPUT_DIR"
bash artifacts/robotwin_hopper/run_eval.sh
