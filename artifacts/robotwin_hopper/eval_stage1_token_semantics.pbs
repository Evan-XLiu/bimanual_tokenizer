#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N token_sem_stage1
#PBS -P CFP05-CF-002
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from the bimanual_tokenizer repository root}"

HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
test -f "$HOPPER_SINGULARITY_IMAGE"

JOB_TMPDIR="$PBS_O_WORKDIR/.t/${PBS_JOBID:?}"
OUTPUT_DIR="$PBS_O_WORKDIR/outputs/stage1_token_semantics/${PBS_JOBID}"
mkdir -p "$JOB_TMPDIR" "$OUTPUT_DIR"

module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
  env \
    JOB_TMPDIR="$JOB_TMPDIR" \
    OUTPUT_DIR="$OUTPUT_DIR" \
    TMPDIR="$JOB_TMPDIR" \
    HF_HOME="$PBS_O_WORKDIR/.cache/huggingface" \
    HF_DATASETS_CACHE="$JOB_TMPDIR/hf_datasets" \
    XDG_CACHE_HOME="$JOB_TMPDIR/xdg" \
    PYTHONUNBUFFERED=1 \
  bash artifacts/robotwin_hopper/eval_stage1_token_semantics.sh

echo "STAGE1_COMPLETE output=$OUTPUT_DIR"
