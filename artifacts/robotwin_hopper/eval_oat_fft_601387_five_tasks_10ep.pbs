#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N oat_fft_5task10
#PBS -P CFP05-CF-002
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1

set -Eeuxo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
PRAXIS_CHECKPOINT=${PRAXIS_CHECKPOINT:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/hopper_bar_oat_pali_fft_new_2500/601387.hopper-m-02/train/checkpoints/latest/pretrained_model}
ROBOTWIN_OUTPUT_BASE=${ROBOTWIN_OUTPUT_BASE:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/oat-fft-601387-five-tasks-10ep}
POLICY_PORT=${POLICY_PORT:-50100}

test -f "$HOPPER_SINGULARITY_IMAGE"
test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"

module load singularity/1.3.1

for task_name in stack_blocks_two adjust_bottle handover_block click_bell place_shoe; do
  export ROBOTWIN_TASK="$task_name"
  export EPISODES_PER_TASK=10
  export RECORD_EPISODES_PER_TASK=10
  export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-500}
  export ROBOTWIN_RUN_ID="oat-fft-601387-${task_name}-10ep"
  export ROBOTWIN_OUTPUT_DIR="$ROBOTWIN_OUTPUT_BASE/$task_name"

  singularity exec --nv --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
    env \
      ROBOTWIN_ROOT="$ROBOTWIN_ROOT" \
      ROBOTWIN_PYTHON="$ROBOTWIN_PYTHON" \
      PRAXIS_CHECKPOINT="$PRAXIS_CHECKPOINT" \
      ROBOTWIN_TASK="$ROBOTWIN_TASK" \
      EPISODES_PER_TASK="$EPISODES_PER_TASK" \
      RECORD_EPISODES_PER_TASK="$RECORD_EPISODES_PER_TASK" \
      MAX_SEED_ATTEMPTS="$MAX_SEED_ATTEMPTS" \
      ROBOTWIN_RUN_ID="$ROBOTWIN_RUN_ID" \
      ROBOTWIN_OUTPUT_DIR="$ROBOTWIN_OUTPUT_DIR" \
      POLICY_PORT="$POLICY_PORT" \
    bash artifacts/robotwin_hopper/run_eval.sh
done
