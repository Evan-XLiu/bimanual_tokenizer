#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N oat_fft_stack2_10
#PBS -P CFP05-CF-002
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export PRAXIS_CHECKPOINT=${PRAXIS_CHECKPOINT:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/hopper_bar_oat_pali_fft_new_2500/601387.hopper-m-02/train/checkpoints/latest/pretrained_model}
export ROBOTWIN_TASK=stack_blocks_two
export EPISODES_PER_TASK=10
export RECORD_EPISODES_PER_TASK=10
export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-500}
export ROBOTWIN_RUN_ID=${ROBOTWIN_RUN_ID:-oat-fft-601387-stack_blocks_two-host-10ep}
export ROBOTWIN_OUTPUT_DIR=${ROBOTWIN_OUTPUT_DIR:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/$ROBOTWIN_RUN_ID}
export POLICY_PORT=${POLICY_PORT:-50100}

test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"

# Use the host RoboTwin environment.  The Hopper Singularity image lacks
# libX11.so.6 required by SAPIEN, while the host environment was used by the
# previously successful rollout jobs.
bash artifacts/robotwin_hopper/run_eval.sh
