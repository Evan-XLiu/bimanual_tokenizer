#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N vla_lat_binfast
#PBS -P CFP05-CF-002
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=12:mem=128gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from repository root}"
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
OUT=${BENCHMARK_OUTPUT_DIR:-$PBS_O_WORKDIR/outputs/vla_latency/20260928_bin_fast}
JOB_TMPDIR="$PBS_O_WORKDIR/.t/${PBS_JOBID:?}"
mkdir -p "$JOB_TMPDIR" "$OUT"
module load singularity/1.3.1
echo "LATENCY_JOB_START job=$PBS_JOBID host=$(hostname) output=$OUT"
singularity exec --nv --bind /scratch:/scratch "$IMAGE" env \
    TMPDIR="$JOB_TMPDIR" HF_HOME="$PBS_O_WORKDIR/.cache/huggingface" \
    HF_DATASETS_CACHE="$JOB_TMPDIR/hf_datasets" XDG_CACHE_HOME="$JOB_TMPDIR/xdg" \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
    PYTHONUNBUFFERED=1 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 ROLLOUT_PROFILE=0 \
    "$PBS_O_WORKDIR/.venv/bin/python" scripts/robotwin/benchmark_vla_latency_baselines.py run \
    --output-dir "$OUT" --warmup 30 --repetitions 3 --threads 8 \
    2>&1 | tee "$OUT/benchmark.log"
echo "LATENCY_JOB_COMPLETE job=$PBS_JOBID"
