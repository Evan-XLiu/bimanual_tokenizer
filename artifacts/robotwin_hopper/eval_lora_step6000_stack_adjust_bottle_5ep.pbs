#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N lora6000_stack_adj_5
#PBS -P CFP05-CF-002
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_model=H100

set -Eeuxo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export PRAXIS_CHECKPOINT=${PRAXIS_CHECKPOINT:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/hopper_bar_fast_pali_lora/598980.hopper-m-02/train/checkpoints/best/step_6800/pretrained_model}
export EPISODES_PER_TASK=5
export RECORD_EPISODES_PER_TASK=5
export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-250}
export ROBOTWIN_OUTPUT_DIR=${ROBOTWIN_OUTPUT_DIR:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/fft-lora-step6000-stack-adjust-bottle-5ep}
export POLICY_PORT=${POLICY_PORT:-50100}

test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"

HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
test -f "$HOPPER_SINGULARITY_IMAGE"
module load singularity/1.3.1

for task_name in stack_blocks_two adjust_bottle; do
  export ROBOTWIN_TASK="$task_name"
  export ROBOTWIN_RUN_ID="lora-step6000-${task_name}-5ep"
  singularity exec --nv --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
    bash artifacts/robotwin_hopper/run_eval.sh
done
