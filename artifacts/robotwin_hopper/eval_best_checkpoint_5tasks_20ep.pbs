#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N best_5task20
#PBS -P CFP05-CF-002
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

: "${EVAL_MODEL_LABEL:?Set EVAL_MODEL_LABEL to the model-specific output name}"
: "${PRAXIS_CHECKPOINT:?Set PRAXIS_CHECKPOINT to the selected best pretrained_model directory}"

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export ROBOTWIN_OUTPUT_BASE=${ROBOTWIN_OUTPUT_BASE:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/best-checkpoint-5tasks-20ep}
export ROBOTWIN_OUTPUT_DIR="$ROBOTWIN_OUTPUT_BASE/$EVAL_MODEL_LABEL"
export EPISODES_PER_TASK=20
export RECORD_EPISODES_PER_TASK=20
export MAX_SEED_ATTEMPTS=1000
export POLICY_PORT=${POLICY_PORT:-50100}

test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"

echo "ROBOTWIN_COMPARE_JOB model=$EVAL_MODEL_LABEL checkpoint=$PRAXIS_CHECKPOINT output=$ROBOTWIN_OUTPUT_DIR"
nvidia-smi --query-gpu=name,uuid --format=csv,noheader

tasks=(
  click_bell
  lift_pot
  pick_dual_bottles
  stack_blocks_two
  put_object_cabinet
)

for task_name in "${tasks[@]}"; do
  export ROBOTWIN_TASK="$task_name"
  export ROBOTWIN_RUN_ID="$EVAL_MODEL_LABEL-$task_name-20ep"
  bash artifacts/robotwin_hopper/run_eval.sh
done

echo "ROBOTWIN_COMPARE_COMPLETE model=$EVAL_MODEL_LABEL output=$ROBOTWIN_OUTPUT_DIR"
