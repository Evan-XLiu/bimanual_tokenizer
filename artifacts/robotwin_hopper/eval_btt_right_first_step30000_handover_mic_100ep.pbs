#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N bttRLmic100
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200
set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?}"
: "${TRAIN_JOB_ID:?Submit with -v TRAIN_JOB_ID=<training job id> and -W depend=afterok:<training job id>}"
TRAIN_OUT="$PWD/outputs/hopper_bar_btt_right_first_pali_robotwin_new_30k/$TRAIN_JOB_ID"
export PRAXIS_CHECKPOINT="$TRAIN_OUT/train/checkpoints/step_30000/pretrained_model"
test -f "$TRAIN_OUT/training_complete.json"
.venv/bin/python - "$TRAIN_OUT/training_complete.json" "$PRAXIS_CHECKPOINT" <<'PY'
import json, sys
from pathlib import Path
done = json.loads(Path(sys.argv[1]).read_text())
assert done['step'] == 30000 and done['checkpoint'] == sys.argv[2]
config = json.loads((Path(sys.argv[2]) / 'config.json').read_text())
assert config['btt_arm_order'] == 'right_then_left'
assert config['action_tokenizer']['name'] == 'btt'
assert config['action_tokenizer']['pretrained_path'] == '/scratch/xuanweiliu/bimanual_tokenizer/outputs/hopper_btt_robotwin_new/621340.hopper-m-02/train/checkpoints/best/step_297000/pretrained_model'
PY
export ROBOTWIN_ROOT=/scratch/xuanweiliu/RoboTwin
export ROBOTWIN_PYTHON=/scratch/xuanweiliu/conda_envs/robotwin/bin/python
export ROBOTWIN_TASK=handover_mic
export EPISODES_PER_TASK=100
export RECORD_EPISODES_PER_TASK=100
export MAX_SEED_ATTEMPTS=5000
export POLICY_PORT=51338
export EVAL_MODEL_LABEL=bar_btt_right_then_left_pali_step30000
export ROBOTWIN_RUN_ID="$EVAL_MODEL_LABEL-handover_mic-100ep"
export ROBOTWIN_OUTPUT_DIR="$PWD/outputs/robotwin_eval/rollout8task_100/BTT_right_then_left/step30000"
export ROBOTWIN_AUX_DIR="$ROBOTWIN_OUTPUT_DIR/_handover_mic_100ep"
mkdir -p "$ROBOTWIN_AUX_DIR"
exec 9>"$ROBOTWIN_AUX_DIR/rollout.lock"
flock -n 9
nvidia-smi --query-gpu=name,uuid --format=csv,noheader
bash artifacts/robotwin_hopper/run_eval.sh
echo "BTT_RIGHT_FIRST_HANDOVER_MIC_100EP_COMPLETE output=$ROBOTWIN_OUTPUT_DIR/handover_mic"
