#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N oat13400_hb20
#PBS -P CFP05-CF-002
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=12:mem=64gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export PRAXIS_CHECKPOINT=${PRAXIS_CHECKPOINT:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/checkpoint_snapshots/bar_oat_pali_fft_step13400/pretrained_model}
export EVAL_MODEL_LABEL=${EVAL_MODEL_LABEL:-bar_oat_pali_fft_step13400}
export ROBOTWIN_OUTPUT_BASE=${ROBOTWIN_OUTPUT_BASE:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/best-checkpoint-5tasks-20ep}
export ROBOTWIN_OUTPUT_DIR="$ROBOTWIN_OUTPUT_BASE/$EVAL_MODEL_LABEL"
export ROBOTWIN_TASK=handover_block
export ROBOTWIN_RUN_ID="$EVAL_MODEL_LABEL-handover_block-20ep"
export EPISODES_PER_TASK=20
export RECORD_EPISODES_PER_TASK=20
export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-1000}
# Use a dedicated port when multiple rollout jobs share one compute node.
export POLICY_PORT=${POLICY_PORT:-50105}

test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"
test -d "$ROBOTWIN_OUTPUT_DIR"

echo "ROBOTWIN_HANDOVER_BLOCK_JOB model=$EVAL_MODEL_LABEL checkpoint=$PRAXIS_CHECKPOINT output=$ROBOTWIN_OUTPUT_DIR"
nvidia-smi --query-gpu=name,uuid --format=csv,noheader

bash artifacts/robotwin_hopper/run_eval.sh

echo "ROBOTWIN_HANDOVER_BLOCK_COMPLETE model=$EVAL_MODEL_LABEL output=$ROBOTWIN_OUTPUT_DIR"
