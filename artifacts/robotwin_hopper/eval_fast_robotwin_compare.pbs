#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N fast_eval_compare
#PBS -P CFP05-CF-002
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=12:mem=64gb

set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit from the bimanual_tokenizer repository root}"

HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
test -f "$HOPPER_SINGULARITY_IMAGE"

module load singularity/1.3.1
singularity exec --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
  bash artifacts/robotwin_hopper/eval_fast_robotwin_compare.sh
