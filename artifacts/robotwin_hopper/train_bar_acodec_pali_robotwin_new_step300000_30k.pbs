#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N bar_acodec_s300k_30k
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from the bimanual_tokenizer repository root}"

HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
test -f "$HOPPER_SINGULARITY_IMAGE"

JOB_TMPDIR="$PBS_O_WORKDIR/.t/${PBS_JOBID:?}"
mkdir -p "$JOB_TMPDIR"
export TMPDIR="$JOB_TMPDIR"

module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
  env \
    JOB_TMPDIR="$JOB_TMPDIR" \
    TMPDIR="$JOB_TMPDIR" \
    POLICY_NAME=bar_acodec_pali \
    TOKENIZER_NAME=acodec \
    TOKENIZER_CHECKPOINT="$PBS_O_WORKDIR/outputs/hopper_acodec_robotwin_new/627717.hopper-m-02/train/checkpoints/recent/step_300000" \
    OUTPUT_BASE="$PBS_O_WORKDIR/outputs/hopper_bar_acodec_pali_robotwin_new_step300000_30k" \
    RUN_NAME=robotwin_new_bar_acodec_pali_step300000_30k \
  bash artifacts/robotwin_hopper/train_bar_tokenizer_pali_robotwin_new_step300000_30k.sh
