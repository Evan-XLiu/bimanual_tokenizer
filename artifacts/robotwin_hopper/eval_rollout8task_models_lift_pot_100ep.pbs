#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N liftpot7m100
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=12:mem=128gb:ngpus=1:gpu_model=H200

# Submit from the repository root:
#   qsub artifacts/robotwin_hopper/eval_rollout8task_models_lift_pot_100ep.pbs
# One GPU runs all seven models sequentially. Set ROBOTWIN_DRY_RUN=1 when
# running with bash to validate all models without launching any GPU work.
set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

# Each child shell owns one policy server and waits for its cleanup before
# the next model starts. A model failure does not skip the remaining models.
if [ -z "${ROBOTWIN_MODEL_INDEX:-}" ]; then
  failed_models=()
  echo "ROBOTWIN_LIFT_POT_SINGLE_GPU_START models=7 episodes_per_model=100"
  for model_index in 1 2 3 4 5 6 7; do
    if ROBOTWIN_MODEL_INDEX="$model_index" bash artifacts/robotwin_hopper/eval_rollout8task_models_lift_pot_100ep.pbs; then
      echo "ROBOTWIN_LIFT_POT_MODEL_DONE index=$model_index"
    else
      model_status=$?
      failed_models+=("$model_index:$model_status")
      echo "ROBOTWIN_LIFT_POT_MODEL_FAILED index=$model_index exit=$model_status" >&2
    fi
  done
  if [ "${#failed_models[@]}" -ne 0 ]; then
    echo "ROBOTWIN_LIFT_POT_SINGLE_GPU_FAILED models=${failed_models[*]}" >&2
    exit 1
  fi
  echo "ROBOTWIN_LIFT_POT_SINGLE_GPU_COMPLETE models=7 episodes_per_model=100"
  exit 0
fi

# Preserve the nested BTT_w/o_convention directory; exclude BTT_handover_test.
case "$ROBOTWIN_MODEL_INDEX" in
  1) MODEL_SUBDIR=BOAT ;;
  2) MODEL_SUBDIR=OAT ;;
  3) MODEL_SUBDIR=Acodec ;;
  4) MODEL_SUBDIR=BTT ;;
  5) MODEL_SUBDIR=BTT_w/o_convention ;;
  6) MODEL_SUBDIR=QueST ;;
  7) MODEL_SUBDIR=BTT_independent ;;
  *) echo "ROBOTWIN_MODEL_INDEX must be an integer from 1 to 7" >&2; exit 2 ;;
esac

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export POLICY_PYTHON=${POLICY_PYTHON:-$PWD/.venv/bin/python}
export ROBOTWIN_OUTPUT_BASE=${ROBOTWIN_OUTPUT_BASE:-$PWD/outputs/robotwin_eval/rollout8task_100}
export ROBOTWIN_OUTPUT_DIR="$ROBOTWIN_OUTPUT_BASE/$MODEL_SUBDIR"
export ROBOTWIN_TASK=lift_pot
export EPISODES_PER_TASK=100
export RECORD_EPISODES_PER_TASK=100
export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-5000}
export POLICY_PORT=${POLICY_PORT:-$((51320 + ROBOTWIN_MODEL_INDEX))}
# Other tasks may still be running in the same model directory. Isolate
# policy logs, source snapshots, CUDA caches and runtime files for this task.
export ROBOTWIN_AUX_DIR="$ROBOTWIN_OUTPUT_DIR/_lift_pot_100ep"

test -x "$POLICY_PYTHON"
test -x "$ROBOTWIN_PYTHON"
test -f "$ROBOTWIN_ROOT/envs/lift_pot.py"
test -d "$ROBOTWIN_OUTPUT_DIR"

# Reuse the checkpoint actually served for the existing evaluation. Pin its
# historical fingerprint so a changed latest/ checkpoint is also rejected.
MODEL_METADATA=$("$POLICY_PYTHON" - "$ROBOTWIN_OUTPUT_DIR" <<'PY'
import json
import sys
from pathlib import Path

output = Path(sys.argv[1])
identities = set()
for path in sorted(output.glob("*/run_manifest.json")):
    if path.parent.name == "lift_pot":
        continue
    manifest = json.loads(path.read_text())
    checkpoint = (manifest.get("server_model_info", {})
                  .get("serving_artifact", {}).get("checkpoint", {}))
    if not checkpoint.get("path") or not checkpoint.get("artifact_sha256"):
        continue
    suffix = f"-{manifest['task']}-100ep"
    run_id = manifest["run_id"]
    if not run_id.endswith(suffix):
        raise SystemExit(f"Unexpected existing run_id in {path}: {run_id}")
    identities.add((str(Path(checkpoint["path"]).resolve()),
                    run_id[:-len(suffix)], checkpoint["artifact_sha256"]))
if len(identities) != 1:
    raise SystemExit(f"Expected one existing model identity in {output}, got {identities}")
checkpoint, label, fingerprint = identities.pop()
for filename in ("config.json", "model.safetensors", "norm_stats.pt", "policy_io.json"):
    if not (Path(checkpoint) / filename).is_file():
        raise SystemExit(f"Missing checkpoint file: {Path(checkpoint) / filename}")
print(checkpoint)
print(label)
print(fingerprint)
PY
)
mapfile -t MODEL_FIELDS <<< "$MODEL_METADATA"
export PRAXIS_CHECKPOINT="${MODEL_FIELDS[0]}"
export EVAL_MODEL_LABEL="${MODEL_FIELDS[1]}"
export PRAXIS_EXPECTED_CHECKPOINT_SHA256="${MODEL_FIELDS[2]}"
export ROBOTWIN_RUN_ID="$EVAL_MODEL_LABEL-lift_pot-100ep"

echo "ROBOTWIN_LIFT_POT_100EP_JOB index=$ROBOTWIN_MODEL_INDEX model=$MODEL_SUBDIR checkpoint=$PRAXIS_CHECKPOINT output=$ROBOTWIN_OUTPUT_DIR/lift_pot episodes=$EPISODES_PER_TASK port=$POLICY_PORT"
if [ "${ROBOTWIN_DRY_RUN:-0}" = "1" ]; then
  echo "ROBOTWIN_LIFT_POT_DRY_RUN_OK model=$MODEL_SUBDIR checkpoint_sha256=$PRAXIS_EXPECTED_CHECKPOINT_SHA256"
  exit 0
fi

mkdir -p "$ROBOTWIN_AUX_DIR"
exec 9>"$ROBOTWIN_AUX_DIR/rollout.lock"
flock -n 9 || { echo "lift_pot is already running for $MODEL_SUBDIR" >&2; exit 1; }
nvidia-smi --query-gpu=name,uuid --format=csv,noheader
# The helper uses demo_clean, seed 0, seen instructions, full video recording
# and --resume; task artifacts go directly into <model>/lift_pot/.
bash artifacts/robotwin_hopper/run_eval.sh
echo "ROBOTWIN_LIFT_POT_100EP_COMPLETE model=$MODEL_SUBDIR output=$ROBOTWIN_OUTPUT_DIR/lift_pot"
