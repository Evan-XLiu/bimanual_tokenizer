#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N pali2task20
#PBS -P CFP05-CF-002
#PBS -J 1-4
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=12:mem=64gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the bimanual_tokenizer repository root}"

case "${PBS_ARRAY_INDEX:-}" in
  1)
    EVAL_MODEL_LABEL=bar_btt_pali_step30000
    PRAXIS_CHECKPOINT="$PWD/outputs/hopper_bar_btt_pali_robotwin_new_30k/622038.hopper-m-02/train/checkpoints/latest/pretrained_model"
    ;;
  2)
    EVAL_MODEL_LABEL=bar_boat_pali_step30000
    PRAXIS_CHECKPOINT="$PWD/outputs/hopper_bar_boat_pali_robotwin_new_30k/616455.hopper-m-02/train/checkpoints/best/step_30000/pretrained_model"
    ;;
  3)
    EVAL_MODEL_LABEL=bar_quest_pali_step26000_retry
    PRAXIS_CHECKPOINT="$PWD/outputs/hopper_bar_quest_pali_robotwin_new_30k/613537.hopper-m-02/train/checkpoints/best/step_26000/pretrained_model"
    ;;
  4)
    EVAL_MODEL_LABEL=bar_btt_pali_step23000
    PRAXIS_CHECKPOINT="$PWD/outputs/hopper_bar_btt_pali_robotwin_new_30k/622038.hopper-m-02/train/checkpoints/best/step_23000/pretrained_model"
    ;;
esac

: "${EVAL_MODEL_LABEL:?Set EVAL_MODEL_LABEL to the existing model output name}"
: "${PRAXIS_CHECKPOINT:?Set PRAXIS_CHECKPOINT to the selected pretrained_model directory}"
export EVAL_MODEL_LABEL PRAXIS_CHECKPOINT

export ROBOTWIN_ROOT=${ROBOTWIN_ROOT:-/scratch/xuanweiliu/RoboTwin}
export ROBOTWIN_PYTHON=${ROBOTWIN_PYTHON:-/scratch/xuanweiliu/conda_envs/robotwin/bin/python}
export ROBOTWIN_OUTPUT_BASE=${ROBOTWIN_OUTPUT_BASE:-/scratch/xuanweiliu/bimanual_tokenizer/outputs/robotwin_eval/best-checkpoint-8tasks-20ep}
export ROBOTWIN_OUTPUT_DIR="$ROBOTWIN_OUTPUT_BASE/$EVAL_MODEL_LABEL"
export EPISODES_PER_TASK=20
export RECORD_EPISODES_PER_TASK=20
export MAX_SEED_ATTEMPTS=${MAX_SEED_ATTEMPTS:-1000}
# Give concurrently scheduled array elements different localhost ports.
export POLICY_PORT=${POLICY_PORT:-$((50100 + ${PBS_ARRAY_INDEX:-0}))}

test -x "$ROBOTWIN_PYTHON"
test -f "$PRAXIS_CHECKPOINT/config.json"
test -f "$PRAXIS_CHECKPOINT/model.safetensors"
test -d "$ROBOTWIN_OUTPUT_DIR"

echo "ROBOTWIN_2TASK_JOB model=$EVAL_MODEL_LABEL checkpoint=$PRAXIS_CHECKPOINT output=$ROBOTWIN_OUTPUT_DIR"
nvidia-smi --query-gpu=name,uuid --format=csv,noheader

tasks=(
  lift_pot
  handover_block
)

for task_name in "${tasks[@]}"; do
  export ROBOTWIN_TASK="$task_name"
  export ROBOTWIN_RUN_ID="$EVAL_MODEL_LABEL-$task_name-20ep"
  bash artifacts/robotwin_hopper/run_eval.sh
done

echo "ROBOTWIN_2TASK_COMPLETE model=$EVAL_MODEL_LABEL output=$ROBOTWIN_OUTPUT_DIR"
