#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N BiCAT_KI_4H200
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=48:mem=384gb:ngpus=4:gpu_model=H200:host=hopper-12

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository root}"
module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch \
  /app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif \
  bash artifacts/bicat_box/run_ki_molmo2er_4xh200.sh train
