#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N BiCAT_BAR_1H200
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200
set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from repository root}"
export BICAT_DATA_ROOT="$PBS_O_WORKDIR/data/BiCAT-BimanualYAM-Dataset"
module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch /app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif bash -lc 'cd "${PBS_O_WORKDIR}" && exec "${PBS_O_WORKDIR}/.venv/bin/python" -m praxis.scripts.train --config-name train_bicat_all_bar_btt_molmo_h200 trainer.batch_size=128 trainer.global_batch_size=null output_dir="${PBS_O_WORKDIR}/outputs/BiCAT_all_BAR_BTT_Molmo2ER_H200/${PBS_JOBID}/train"'
