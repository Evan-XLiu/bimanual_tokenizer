#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N BiCAT_KI_stages96
#PBS -P CFP05-CF-002
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200
set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from repository root}"
module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch \
  /app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif \
  env TEST_BATCH_SIZE=96 TEST_KI_STAGES=1 \
  bash artifacts/bicat_box/run_ki_molmo2er.sh single-resize-test
