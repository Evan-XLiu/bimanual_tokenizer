#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N tokenizer_box_oat_test
#PBS -P CFP05-CF-002
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from the bimanual_tokenizer repository root}"
HOPPER_SINGULARITY_IMAGE=${HOPPER_SINGULARITY_IMAGE:-/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif}
test -f "$HOPPER_SINGULARITY_IMAGE"
module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch "$HOPPER_SINGULARITY_IMAGE" \
  env TRAIN_OUTPUT_PARENT="/scratch/xuanweiliu/bimanual_tokenizer/outputs/tokenizer_box_oat_test/653979.hopper-m-02" \
    RESUME_CHECKPOINT="/scratch/xuanweiliu/bimanual_tokenizer/outputs/tokenizer_box_oat_test/653979.hopper-m-02/train/checkpoints/latest" \
  bash artifacts/bicat_box/train_tokenizer_box_oat_test.sh
