#!/usr/bin/env bash
#PBS -j oe
#PBS -k oed
#PBS -N RW_VLA_OAT
#PBS -P CFP05-CF-002
#PBS -l walltime=144:00:00
#PBS -l select=1:ncpus=12:mem=225gb:ngpus=1:gpu_model=H200
#PBS -o /scratch/xuanweiliu/bimanual_tokenizer/artifacts/realworld_vla_30k/logs/oat.pbs.log
set -Eeuo pipefail
cd /scratch/xuanweiliu/bimanual_tokenizer
export PYTHONUNBUFFERED=1 HYDRA_FULL_ERROR=1 WANDB_MODE=online
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
export BICAT_DATA_ROOT=/scratch/xuanweiliu/bimanual_tokenizer/data/BiCAT-BimanualYAM-Dataset
module load singularity/1.3.1
singularity exec --nv --bind /scratch:/scratch /app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif /scratch/xuanweiliu/bimanual_tokenizer/.venv/bin/python -u /scratch/xuanweiliu/bimanual_tokenizer/artifacts/realworld_vla_30k/launch.py oat
