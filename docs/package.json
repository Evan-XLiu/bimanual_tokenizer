{
  "name": "praxis-docs",
  "version": "0.1.0",
  "description": "Documentation for Praxis",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev --host 127.0.0.1",
    "docs:build": "vitepress build",
    "docs:check": "PYTHON_BIN=\"${PYTHON_BIN:-../.venv/bin/python}\" && \"$PYTHON_BIN\" scripts/check_snippets.py",
    "docs:preview": "vitepress preview --host 127.0.0.1"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^2.0.0-alpha.12",
    "vue": "^3.4.0"
  }
}
